# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env* 는 git에 올라가지 않습니다)
#
#   cp .env.example .env.local
#
# 값을 바꾼 뒤에는 개발 서버를 껐다 켜야 반영됩니다.

# ── AI 기능 (「✦ 대본으로 퀴즈 만들기」) ────────────────────────────
# 없으면 그 버튼만 동작하지 않고, 나머지 기능은 모두 그대로 씁니다.
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── 여러 기기에서 같이 쓰기 (배포용) ───────────────────────────────
# 없으면 로컬 파일(.classflow/)에 저장합니다 — 내 컴퓨터 안에서만 공유됩니다.
# Vercel 등에 올려 다른 기기와 함께 쓰려면 둘 다 채워야 합니다.
# 발급: https://console.upstash.com  (Redis → REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Lightsail PPT 변환 (서버 연결·검증 후 1로 활성화) ───────────────
PPT_CONVERSION_ENABLED=0
# Vercel과 Lightsail outbound agent에만 동일하게 설정. 클라이언트에 노출 금지.
CONVERSION_WORKER_SECRET=
BLOB_READ_WRITE_TOKEN=
