# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env* 는 git에 올라가지 않습니다)
#
#   cp .env.example .env.local
#
# 값을 바꾼 뒤에는 개발 서버를 껐다 켜야 반영됩니다.

# ── AI 기능 (「✦ 대본으로 퀴즈 만들기」) ────────────────────────────
# 없으면 그 버튼만 동작하지 않고, 나머지 기능은 모두 그대로 씁니다.
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── 여러 기기에서 같이 쓰기 (배포용) ───────────────────────────────
# 없으면 로컬 파일(.classflow/)에 저장합니다 — 내 컴퓨터 안에서만 공유됩니다.
# Vercel 등에 올려 다른 기기와 함께 쓰려면 둘 다 채워야 합니다.
# 발급: https://console.upstash.com  (Redis → REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Lightsail PPT 변환 (서버 연결·검증 후 1로 활성화) ───────────────
PPT_CONVERSION_ENABLED=0
# Vercel과 Lightsail outbound agent에만 동일하게 설정. 클라이언트에 노출 금지.
CONVERSION_WORKER_SECRET=
BLOB_READ_WRITE_TOKEN=

# Optional real-time chat. Leave blank until the separate chat server is verified.
# The submitted Vercel website address does not change.
CHAT_SERVER_URL=
CHAT_TOKEN_SECRET=

# ── 로그인 (Supabase, 스토어 yuco-store와 같은 프로젝트) ──────────────────
# 세 사이트(스토어·클래스플로우·강사풀)가 계정을 공유합니다. 개발/운영 프로젝트는 분리합니다.
# 비워두면 로그인 화면은 "준비 중" 안내만 띄우고 나머지 기능은 그대로 동작합니다.
# Supabase 대시보드 → Authentication → URL Configuration의 Redirect URLs에
#   {NEXT_PUBLIC_SITE_URL}/auth/callback 을 추가해야 메일 링크 로그인이 됩니다.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3311
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 구글 로그인 버튼 표시. Supabase 대시보드에서 Google 공급자를 켠 뒤에만 1로 바꿉니다.
# (켜지 않고 1로 두면 버튼을 눌렀을 때 Supabase 오류 화면이 나옵니다)
AUTH_GOOGLE_ENABLED=0
# 네이버 로그인 버튼 표시. Supabase에 사용자 지정 공급자 custom:naver 등록 + naver-userinfo 함수 배포 후 1로.
AUTH_NAVER_ENABLED=0
