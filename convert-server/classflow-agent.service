[Unit]
Description=ClassFlow outbound conversion job agent
After=network-online.target classflow-convert.service
Wants=network-online.target
Requires=classflow-convert.service

[Service]
User=classflow
Group=classflow
ExecStart=/usr/local/bin/node /opt/classflow-convert/agent.mjs
EnvironmentFile=/etc/classflow-agent.env
WorkingDirectory=/var/lib/classflow-convert
Restart=always
RestartSec=10
MemoryMax=1G
TasksMax=64
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
